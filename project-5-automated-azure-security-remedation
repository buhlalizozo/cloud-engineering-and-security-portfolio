import os
from azure.identity import AzureCliCredential
from azure.mgmt.storage import StorageManagementClient

# --- Configuration ---
SUBSCRIPTION_ID = "ad4ecac9-e6af-48fa-868a-0cd67594ce71"
RESOURCE_GROUP = "rg-project5-remediation"

def main():
    credential = AzureCliCredential()
    storage_client = StorageManagementClient(credential, SUBSCRIPTION_ID)

    print(f"Scanning storage accounts in resource group '{RESOURCE_GROUP}'...\n")

    accounts = storage_client.storage_accounts.list_by_resource_group(RESOURCE_GROUP)

    for account in accounts:
        name = account.name
        public_access = account.allow_blob_public_access

        print(f"Storage Account: {name}")
        print(f" Allow Blob Public Access: {public_access}")

        if public_access:
            print(f" [!] MISCONFIGURATION DETECTED: Public blob access is enabled.")
            print(f" Remediating: disabling public access...")

            from azure.mgmt.storage.models import StorageAccountUpdateParameters

            update_params = StorageAccountUpdateParameters(
                allow_blob_public_access=False
            )

            storage_client.storage_accounts.update(
                RESOURCE_GROUP,
                name,
                update_params
            )
            print(f" [OK] Public access has been disabled on '{name}'.\n")
        else:
            print(f" [OK] No misconfiguration found.\n")

if __name__ == "__main__":
    main()
